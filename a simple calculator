import math
num1 = int(input("enter a number: "))
num2 = int(input("enter another number: "))
operation = input("enter an operation :")#(+, -, *, /, **) choosen
print(f"the result of {num1} {operation} {num2} = ", end="")
if operation == "+":
    print(num1 +num2)
elif operation == "-":
    print(num1 -num2)
elif operation == "*":
    print(num1*num2)
elif operation == "/":
    print(num1/num2)
elif operation == "**":
    print(num1**num2)
elif operation == "%":
    print(num1%num2)
else:
    print("invalid operation")




