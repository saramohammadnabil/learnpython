def heart_boundary(scale=22, steps=400):
    """يحسب نقاط حدود القلب (المعادلة الرياضية) وبيرجعها كـ (x, y) حوالين المنتصف."""
    pts = []
    for t in np.linspace(0, 2 * math.pi, steps):
        x = scale * 16 * math.sin(t) ** 3
        y = -scale * (13 * math.cos(t) - 5 * math.cos(2 * t) - 2 * math.cos(3 * t) - math.cos(4 * t))
        pts.append((x + WIDTH // 2, y + HEIGHT // 2))