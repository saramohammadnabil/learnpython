import turtle
import math
import random

screen = turtle.Screen()
screen.setup(900, 900)
screen.bgcolor("black")
screen.title("Colorful Heart")

t = turtle.Turtle()
t.speed(40)          # سرعة متوسطة عشان تشوفي الرسم
t.pensize(1)
t.hideturtle()

colors = [
    "red", "blue", "lime", "yellow",
    "cyan", "magenta", "orange",
    "pink", "white", "purple"
]

scale = 22

for i in range(180):
    angle = i * (2 * math.pi) / 180

    x = 16 * (math.sin(angle) ** 3) * scale
    y = (
        13 * math.cos(angle)
        - 5 * math.cos(2 * angle)
        - 2 * math.cos(3 * angle)
        - math.cos(4 * angle)
    ) * scale

    t.penup()
    t.goto(0, 0)
    t.pendown()

    t.color(random.choice(colors))
    t.goto(x, y)

    t.penup()
    t.goto(x, y)
    t.pendown()

    for _ in range(8):
        t.forward(6)
        t.backward(6)
        t.right(45)

turtle.done()